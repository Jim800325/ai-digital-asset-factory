DATABASE_URL=postgresql+psycopg://assetfactory:assetfactory@postgres:5432/assetfactory
REDIS_URL=redis://redis:6379/0
USER_AGENT=AI-Digital-Asset-Factory/0.3
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGES_PER_RUN=20
SEED_URLS=https://news.ycombinator.com/,https://github.com/trending
GITHUB_DISCOVERY_ENABLED=true
GITHUB_RESULTS_PER_QUERY=10

# Side-Business Provider Registry. The daily scheduler re-scores known providers,
# discovers new public GitHub candidates, and maintains a BUILD_READY provider queue.
SIDE_BUSINESS_REGISTRY_ENABLED=true
SIDE_BUSINESS_DISCOVERY_ENABLED=true
SIDE_BUSINESS_RESULTS_PER_QUERY=8
SIDE_BUSINESS_MAX_CANDIDATES_PER_RUN=40
SIDE_BUSINESS_BUILD_READY_SCORE=75

# Optional. Leave empty for unauthenticated public GitHub discovery.
# A token is strongly recommended for the daily registry because GitHub's anonymous
# API limit is much lower than the authenticated limit.
GITHUB_TOKEN=
SCHEDULE_START_DELAY_SECONDS=60
SCHEDULE_INTERVAL_SECONDS=86400

# Required before human approval API can approve/reject build proposals.
# Use a long random value and never commit the real key.
HUMAN_APPROVAL_KEY=

# Separate key for Human Release Gate decisions. Keep empty until release review is intended.
HUMAN_RELEASE_KEY=

# Deployment Authorization Gate and isolated Preview acceptance.
HUMAN_DEPLOYMENT_KEY=
PREVIEW_DATABASE_URL=
PREVIEW_ACCEPTANCE_KEY=
DEPLOYMENT_AUTHORIZATION_PREVIEW_ONLY=true

# Third independent human gate for Controlled Production Release Executor.
# Must not reuse HUMAN_APPROVAL_KEY, HUMAN_RELEASE_KEY, or HUMAN_DEPLOYMENT_KEY.
HUMAN_PRODUCTION_EXECUTION_KEY=

# Controlled Production Release Executor defaults. MOCK is the safe baseline.
CONTROLLED_PRODUCTION_EXECUTOR_ENABLED=false
PRODUCTION_PROMOTION_ENABLED=false
PRODUCTION_ROLLBACK_ENABLED=false
PRODUCTION_EXECUTION_ADAPTER=MOCK

# Step 4 Vercel PREPARE acceptance. Leave allowlists/token empty by default.
# VERCEL_CONTROLLED_EXECUTOR is Preview-only and may target ONLY a dedicated
# sacrificial project. The real ai-digital-asset-factory project stays denied.
PRODUCTION_EXECUTION_PREVIEW_ONLY=true
PRODUCTION_EXECUTION_ALLOWED_PROJECT_IDS=
PRODUCTION_EXECUTION_ALLOWED_TEAM_IDS=
PRODUCTION_EXECUTION_DENIED_PROJECT_IDS=prj_orLCRCIm7aVfImH8ihB3gponFOEl
VERCEL_CONTROLLED_EXECUTOR_TOKEN=
VERCEL_CONTROLLED_EXECUTOR_API_BASE=https://api.vercel.com
VERCEL_CONTROLLED_EXECUTOR_TIMEOUT_SECONDS=30

# v0.3 sandbox execution gate. Disabled by default.
SANDBOX_EXECUTION_ENABLED=false
SANDBOX_WORKSPACE_ROOT=/tmp/asset-factory-workspaces
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=300

# OpenHands is not invoked until the sandbox gate has passed.
OPENHANDS_ENABLED=false
OPENHANDS_RUNTIME=process
OPENHANDS_CLI_VERSION=1.16.0
OPENHANDS_CLI_IMAGE=asset-factory-openhands:1.16.0
OPENHANDS_GATEWAY_MODE=PROXY
OPENHANDS_GATEWAY_IMAGE=python:3.12-slim
OPENHANDS_MODEL=
OPENHANDS_LLM_UPSTREAM_URL=
OPENHANDS_LLM_API_KEY=

# Controlled LLM proxy limits. PROXY mode is fail-closed unless model allowlist
# and positive provider pricing are explicitly configured.
OPENHANDS_ALLOWED_MODELS=
OPENHANDS_MAX_REQUESTS=8
OPENHANDS_MAX_PROMPT_TOKENS_PER_REQUEST=12000
OPENHANDS_MAX_COMPLETION_TOKENS_PER_REQUEST=4000
OPENHANDS_MAX_TOTAL_TOKENS=24000
OPENHANDS_MAX_COST_PER_REQUEST_USD=0.10
OPENHANDS_MAX_COST_USD=0.25
OPENHANDS_INPUT_COST_PER_1M_USD=0
OPENHANDS_OUTPUT_COST_PER_1M_USD=0
